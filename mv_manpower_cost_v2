create materialized view public.mv_manpower_cost_v2 as
-- List outlet 1 kesatuan
WITH outlet_map AS (
    SELECT *
    FROM (
        VALUES 
            ('Balonggede 2', 'Balonggede'),
            ('Baltos 2', 'Baltos'),
            ('Jatinangor 2', 'Jatinangor'),
            ('Paskal 2', 'Paskal'),
            ('Saparua 2', 'Saparua'),
            ('Sekeloa 2', 'Sekeloa'),
            ('Unjani 2', 'Unjani'),
            ('Miko Mall Kopo', 'Alfamart Kopo')
    ) AS tab(outlet_raw, outlet_clean)),

-- master outlet dengan nama yang udh di standarisasi
-- udh disatuin outlet2 yang sama dan disini kita select distinct
master_out AS (
    SELECT
        DISTINCT city as branch,
        COALESCE(om.outlet_clean, mo.outlet_name_std) AS outlet_name
    FROM public.master_outlet mo
    LEFT JOIN outlet_map om
        ON mo.outlet_name_std = om.outlet_raw),

-- ambil distinct data mv_outlet_attendance_performance (di distinct karna bisa jadi datanya duplikat/2x absen)
performa_mapped_distinct AS (
    SELECT DISTINCT
        tanggal_sales,
        COALESCE(om.outlet_clean, ap.outlet) AS outlet_name,
        ap.sales,
        actual_working_time,
        supposed_working_time,
        posisi,
        crew
    FROM mv_outlet_attendance_performance ap
    LEFT JOIN outlet_map om
        ON ap.outlet = om.outlet_raw),

-- agregasi berdasarkan outlet_name yang sudah clean
performa AS (
    SELECT
        tanggal_sales tanggal,
        outlet_name outlet,
        SUM(DISTINCT sales) AS sales,  -- buat mencegah double count
        SUM(distinct actual_working_time) AS act_working_time,
        SUM(distinct supposed_working_time) AS supposed_working_time,
        COUNT(DISTINCT CASE WHEN posisi = 'PIC/Backup' THEN crew END) AS jumlah_pic,
        COUNT(DISTINCT CASE WHEN posisi = 'Perbantuan' THEN crew END) AS jumlah_perbantuan,
        COUNT(DISTINCT crew) AS total_crew
    FROM performa_mapped_distinct
    GROUP BY tanggal_sales, outlet_name),

-- ambil informasi branch
with_branch as(select p.*, mo.branch
from performa p
left join master_out mo on p.outlet = mo.outlet_name),

-- hitung salary dari petty cash (data accounting)
manpower_salary as(
SELECT pc.tanggal, COALESCE(om.outlet_clean, pc.outlet_tag_clean) as outlet_name, sum(pc.kredit) salary
from combine_petty_cash_outlet pc
left join outlet_map om on pc.outlet_tag_clean = om.outlet_raw
where pc.kategori::text = 'Gaji' and pc.outlet_tag_clean not in ('Pasar Sederhana')
group by pc.tanggal, COALESCE(om.outlet_clean, pc.outlet_tag_clean)),


spv_outlet as(
SELECT tanggal_penjualan, outlet_tag_clean, spv,
ROW_NUMBER() over(partition by tanggal_penjualan, outlet_tag_clean order by tanggal_penjualan) rn
FROM
public.master_target),


